<?xml version="1.0" encoding="utf-8"?>
<!-- AI Researcher animated banner for Riya Indap
     Save as assets/ai-banner.svg and embed in README.md -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 360" preserveAspectRatio="xMidYMid slice">
  <defs>
    <!-- gradient background -->
    <linearGradient id="bgGrad" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0%" stop-color="#0f0221"/>
      <stop offset="40%" stop-color="#0b2447"/>
      <stop offset="100%" stop-color="#190023"/>
    </linearGradient>

    <!-- subtle wave overlay -->
    <linearGradient id="waveGrad" x1="0" x2="1">
      <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.28"/>
      <stop offset="50%" stop-color="#00d4ff" stop-opacity="0.18"/>
      <stop offset="100%" stop-color="#ff6ec7" stop-opacity="0.16"/>
    </linearGradient>

    <!-- glow filter -->
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6" result="b"/>
      <feMerge>
        <feMergeNode in="b"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <!-- node pulse animation (for reuse) -->
    <circle id="nodeBase" r="8" fill="#7c3aed" opacity="1"/>

    <!-- small particle shape -->
    <g id="particle">
      <circle r="2.2" fill="#fff"/>
    </g>

    <!-- stroke style for links -->
    <style type="text/css"><![CDATA[
      .link { stroke: #7c3aed; stroke-width:1.8; stroke-linecap:round; opacity:0.65; filter: url(#glow); }
      .node  { fill: #7c3aed; stroke: none; filter: url(#glow); }
      .pnode { fill: #00d4ff; filter: url(#glow); }
      .text-main { font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial; font-weight:700; fill: #e8f8ff; }
      .text-sub  { font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial; font-weight:500; fill: #cdefff; opacity:0.9; }
    ]]></style>
  </defs>

  <!-- background -->
  <rect width="1200" height="360" rx="0" ry="0" fill="url(#bgGrad)"/>

  <!-- subtle animated waves -->
  <g transform="translate(0,240)">
    <path d="M0 90 C 150 40, 350 140, 600 90 C 850 40, 1050 140, 1200 90 L 1200 200 L 0 200 Z"
          fill="url(#waveGrad)" opacity="0.14">
      <animate attributeName="d" dur="8s" repeatCount="indefinite"
        values="
          M0 90 C 150 40, 350 140, 600 90 C 850 40, 1050 140, 1200 90 L 1200 200 L 0 200 Z;
          M0 80 C 150 120, 350 30, 600 100 C 850 170, 1050 60, 1200 120 L 1200 200 L 0 200 Z;
          M0 90 C 150 40, 350 140, 600 90 C 850 40, 1050 140, 1200 90 L 1200 200 L 0 200 Z"/>
    </path>
  </g>

  <!-- floating particles (animated opacities & vertical drift) -->
  <g id="particles" opacity="0.95">
    <!-- repeated particles placed across the banner -->
    <use href="#particle" x="60"  y="40">
      <animate attributeName="y" values="40;55;40" dur="6s" repeatCount="indefinite" begin="0s"/>
      <animate attributeName="opacity" values="0.9;0.2;0.9" dur="6s" repeatCount="indefinite" begin="0s"/>
    </use>
    <use href="#particle" x="150" y="20">
      <animate attributeName="y" values="20;35;20" dur="7.5s" repeatCount="indefinite" begin="0.6s"/>
      <animate attributeName="opacity" values="0.8;0.15;0.8" dur="7.5s" repeatCount="indefinite" begin="0.6s"/>
    </use>
    <use href="#particle" x="290" y="70">
      <animate attributeName="y" values="70;50;70" dur="9s" repeatCount="indefinite" begin="1.2s"/>
      <animate attributeName="opacity" values="0.85;0.2;0.85" dur="9s" repeatCount="indefinite" begin="1.2s"/>
    </use>
    <use href="#particle" x="470" y="30">
      <animate attributeName="y" values="30;45;30" dur="6.5s" repeatCount="indefinite" begin="0.9s"/>
      <animate attributeName="opacity" values="0.95;0.18;0.95" dur="6.5s" repeatCount="indefinite" begin="0.9s"/>
    </use>
    <use href="#particle" x="680" y="55">
      <animate attributeName="y" values="55;40;55" dur="8s" repeatCount="indefinite" begin="0.3s"/>
      <animate attributeName="opacity" values="0.9;0.12;0.9" dur="8s" repeatCount="indefinite" begin="0.3s"/>
    </use>
    <use href="#particle" x="840" y="25">
      <animate attributeName="y" values="25;40;25" dur="7s" repeatCount="indefinite" begin="0.2s"/>
      <animate attributeName="opacity" values="0.86;0.2;0.86" dur="7s" repeatCount="indefinite" begin="0.2s"/>
    </use>
    <use href="#particle" x="1020" y="68">
      <animate attributeName="y" values="68;50;68" dur="8.6s" repeatCount="indefinite" begin="1.1s"/>
      <animate attributeName="opacity" values="0.9;0.16;0.9" dur="8.6s" repeatCount="indefinite" begin="1.1s"/>
    </use>
  </g>

  <!-- neural network cluster (left) -->
  <g id="neural-left" transform="translate(160,150)">
    <!-- connection lines -->
    <path class="link" d="M20,20 L120,30 L220,10" stroke-linejoin="round" opacity="0.6">
      <animate attributeName="stroke-dashoffset" from="400" to="0" dur="5s" repeatCount="indefinite"/>
    </path>
    <path class="link" d="M20,80 L120,60 L220,80" stroke-linejoin="round" opacity="0.55">
      <animate attributeName="stroke-dashoffset" values="0; -300; 0" dur="6s" repeatCount="indefinite"/>
    </path>

    <!-- nodes -->
    <g>
      <circle class="node" cx="20" cy="20" r="6">
        <animate attributeName="r" values="6;10;6" dur="2.6s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.8;0.35;0.8" dur="2.6s" repeatCount="indefinite"/>
      </circle>
      <circle class="node" cx="120" cy="30" r="6">
        <animate attributeName="r" values="6;12;6" dur="3s" repeatCount="indefinite" begin="0.4s"/>
        <animate attributeName="opacity" values="0.9;0.3;0.9" dur="3s" repeatCount="indefinite" begin="0.4s"/>
      </circle>
      <circle class="node" cx="220" cy="10" r="6">
        <animate attributeName="r" values="6;11;6" dur="2.8s" repeatCount="indefinite" begin="0.8s"/>
        <animate attributeName="opacity" values="0.85;0.28;0.85" dur="2.8s" repeatCount="indefinite" begin="0.8s"/>
      </circle>

      <circle class="pnode" cx="70" cy="55" r="4">
        <animate attributeName="r" values="4;8;4" dur="3.6s" repeatCount="indefinite"/>
      </circle>
      <circle class="pnode" cx="170" cy="65" r="4">
        <animate attributeName="r" values="4;9;4" dur="3.2s" repeatCount="indefinite" begin="0.6s"/>
      </circle>
    </g>
  </g>

  <!-- neural network cluster (right, rotated) -->
  <g id="neural-right" transform="translate(760,140) rotate(-6)">
    <path class="link" d="M20,30 L90,10 L190,40" stroke-linejoin="round" opacity="0.62">
      <animate attributeName="stroke-dasharray" values="1 6; 8 6; 1 6" dur="4.6s" repeatCount="indefinite"/>
    </path>
    <path class="link" d="M25,85 L110,70 L190,80" stroke-linejoin="round" opacity="0.5">
      <animate attributeName="stroke-dashoffset" values="0; -200; 0" dur="5.6s" repeatCount="indefinite"/>
    </path>

    <circle class="node" cx="20" cy="30" r="6">
      <animate attributeName="r" values="6;11;6" dur="2.5s" repeatCount="indefinite"/>
    </circle>
    <circle class="node" cx="90" cy="10" r="6">
      <animate attributeName="r" values="6;10;6" dur="3.2s" repeatCount="indefinite" begin="0.4s"/>
    </circle>
    <circle class="node" cx="190" cy="40" r="6">
      <animate attributeName="r" values="6;11.5;6" dur="2.9s" repeatCount="indefinite" begin="0.8s"/>
    </circle>

    <circle class="pnode" cx="120" cy="60" r="4">
      <animate attributeName="r" values="4;8;4" dur="3.5s" repeatCount="indefinite" begin="0.3s"/>
    </circle>
  </g>

  <!-- connections across clusters -->
  <g>
    <path class="link" d="M360,150 C 470 110, 620 70, 720 140" fill="none" stroke-width="1.8" opacity="0.55"/>
    <path class="link" d="M340,170 C 520 200, 680 220, 820 170" fill="none" stroke-width="1.2" opacity="0.45"/>
  </g>

  <!-- subtle animated radial pulses centered near text -->
  <g transform="translate(540,140)">
    <circle r="8" fill="#7c3aed" opacity="0.06">
      <animate attributeName="r" values="8;160;8" dur="6.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.06;0.00;0.06" dur="6.5s" repeatCount="indefinite"/>
    </circle>
    <circle r="6" fill="#00d4ff" opacity="0.04">
      <animate attributeName="r" values="6;120;6" dur="7.6s" repeatCount="indefinite" begin="0.9s"/>
      <animate attributeName="opacity" values="0.04;0.00;0.04" dur="7.6s" repeatCount="indefinite" begin="0.9s"/>
    </circle>
  </g>

  <!-- neon text block -->
  <g transform="translate(360,120)">
    <text class="text-main" x="0" y="0" font-size="34" letter-spacing="0.2">
      Hi , I'm Riya Indap
      <animate attributeName="opacity" values="1;0.85;1" dur="3.5s" repeatCount="indefinite"/>
    </text>

    <text class="text-sub" x="0" y="46" font-size="18" letter-spacing="0.6">
      A passionate IT Engineering student | Developer | Tech Explorer
      <animate attributeName="opacity" values="0.95;0.7;0.95" dur="4.6s" repeatCount="indefinite" />
    </text>

    <!-- stylized underline glow -->
    <rect x="0" y="58" width="520" height="2.8" rx="2" ry="2" fill="#ff6ec7" opacity="0.12">
      <animate attributeName="opacity" values="0.12;0.28;0.12" dur="3s" repeatCount="indefinite"/>
    </rect>
  </g>

  <!-- orbiting micro-icons (represented as small neon circles) -->
  <g transform="translate(540,80)">
    <g id="orbit">
      <circle cx="0" cy="-80" r="6" class="pnode">
        <animateTransform attributeName="transform" attributeType="XML" type="rotate"
                          from="0 0 0" to="360 0 0" dur="11s" repeatCount="indefinite"/>
      </circle>
      <circle cx="-70" cy="-45" r="5" class="node">
        <animateTransform attributeName="transform" attributeType="XML" type="rotate"
                          from="0 0 0" to="-360 0 0" dur="13s" repeatCount="indefinite"/>
      </circle>
      <circle cx="70" cy="-45" r="4.5" class="pnode">
        <animateTransform attributeName="transform" attributeType="XML" type="rotate"
                          from="0 0 0" to="360 0 0" dur="9.8s" repeatCount="indefinite"/>
      </circle>
    </g>
  </g>

  <!-- finishing subtle vignette -->
  <rect width="1200" height="360" fill="black" opacity="0.03"/>
</svg>
